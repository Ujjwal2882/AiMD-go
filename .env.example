# ──────────────────── Database (Supabase / PostGIS) ────────────────────
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres

# ──────────────────── Redis / Celery (Upstash) ────────────────────
# Upstash connection string (secure rediss://)
REDIS_URL=rediss://default:[YOUR-PASSWORD]@[YOUR-ENDPOINT].upstash.io:6379
CELERY_BROKER_URL=rediss://default:[YOUR-PASSWORD]@[YOUR-ENDPOINT].upstash.io:6379
CELERY_RESULT_BACKEND=rediss://default:[YOUR-PASSWORD]@[YOUR-ENDPOINT].upstash.io:6379

# ──────────────────── Google Drive Integration ────────────────────
# 1. Place your Service Account JSON file as "credentials.json" in the project root.
# 2. Set the ID of the Google Drive folder where uploads should go.
GOOGLE_DRIVE_FOLDER_ID=

# ──────────────────── CORS (for production) ────────────────────
CORS_ORIGINS=https://aimd-go.netlify.app,http://localhost:3000,http://localhost:8000

# ──────────────────── Security ────────────────────
SECRET_KEY=super_secret_key_change_in_production
