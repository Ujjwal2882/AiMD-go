# AiMD-go Environment Configuration
# Copy this file to .env and customize values

# Application
APP_NAME=AiMD-go
APP_VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

# AI Model (optional — used for detection)
AI_MODEL_NAME=yolov8l.pt
AI_CONFIDENCE_THRESHOLD=0.5

# Upload Limits
MAX_UPLOAD_SIZE_MB=500
